# Пример env-файла для pg-s3-backup: скопируйте в stack.env и заполните.
#   cp stack.env.example stack.env   # stack.env в .gitignore — секреты не попадут в git
#
# Способы использования (можно смешивать, окружение приоритетнее файла):
#   compose:   volumes: [./stack.env:/etc/pg-backup/env:ro]   (либо переменные в environment:)
#   swarm:     тот же том — stack-файл игнорирует env_file:
#   локально:  make run            (Makefile делает docker run --env-file ./stack.env)
#   напрямую:  docker run -e ENV_FILE=/etc/pg-backup/env -v $PWD/stack.env:/etc/pg-backup/env:ro ...
#
# Формат: KEY=VALUE, # — комментарий, кавычки можно не ставить (окружающие кавычки снимаются).

# --- БД (PGHOST = имя сервиса БД в общей сети) ---
PGHOST=postgres-db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_ME
ADMIN_DB=postgres

# --- S3 (rclone: конфиг через переменные окружения, без файла) ---
S3_ENDPOINT=https://s3.kz-1.srvstorage.kz
S3_REGION=kz-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=CHANGE_ME
S3_PREFIX=myapp
# --- поведение ---
KEEP=7
ZSTD_LEVEL=9
INTERVAL=86400
EXCLUDE_DBS=postgres
DUMP_GLOBALS=1

# --- проверки целостности ---
VERIFY=1
# полное локальное чтение архива (ловит обрыв данных); трафика нет
VERIFY_FULL=1
# проверка объекта в S3 без скачивания (размер, и MD5 для объектов < 200 МиБ)
VERIFY_REMOTE=1
# 1 = ДОПОЛНИТЕЛЬНО скачать объект из S3 и проверить целиком (это исходящий трафик!)
VERIFY_DOWNLOAD=0
RESTORE_TEST=0

EXTRA_PGDUMP_ARGS=
# путь к этому файлу внутри контейнера (по умолчанию /etc/pg-backup/env)
ENV_FILE=/etc/pg-backup/env
# 1 = один прогон и выход (для тестов/CI); код возврата = были ли ошибки
RUN_ONCE=0
# секунд ожидания БД при старте; 0 = ждать бесконечно
WAIT_DB_TIMEOUT=0
